APP_NOME=Devacancy
APP_URL=http://devacancy.test
APP_AMBIENTE=local

DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=devacancy
DB_USUARIO=root
DB_SENHA=

# Login social — preencha depois de criar os apps OAuth.
# URLs de retorno: {APP_URL}/auth/google/retorno, /auth/github/retorno, /auth/linkedin/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pagamentos — ExPay (https://expaybrasil.com/docs). Sem chave, em ambiente local, o checkout roda em modo simulação.
# Webhook: configure no painel ExPay a URL {APP_URL}/webhooks/expay?token={EXPAY_WEBHOOK_TOKEN}
EXPAY_URL=https://api.expay.com.br/v1
EXPAY_API_KEY=
EXPAY_WEBHOOK_TOKEN=

# PayPal — assinaturas recorrentes (Brasil em BRL, resto do mundo em USD). Modo: sandbox ou live.
# Depois de preencher ID e segredo, rode: php database/paypal-planos.php  (cria os planos e mostra os IDs abaixo)
# Webhook no painel do PayPal: {APP_URL}/webhooks/paypal?token={PAYPAL_WEBHOOK_TOKEN}
PAYPAL_MODO=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_TOKEN=
PAYPAL_PLANO_SEMANAL_BRL=
PAYPAL_PLANO_MENSAL_BRL=
PAYPAL_PLANO_TRIMESTRAL_BRL=
PAYPAL_PLANO_SEMANAL_USD=
PAYPAL_PLANO_MENSAL_USD=
PAYPAL_PLANO_TRIMESTRAL_USD=

# Importação de vagas do GitHub (opcional: sem token, o limite é 60 consultas por hora).
# Rodar todo dia: php database/importar-vagas.php
GITHUB_TOKEN=

# Rodar migrações pelo navegador em {APP_URL}/install (útil sem acesso ao terminal). Use um valor longo e aleatório
# (16+ caracteres) e APAGUE depois de usar: sem esse valor a rota deixa de existir.
# Na mesma tela dá para criar/promover o administrador (e-mail + senha). No painel admin, /admin/migracoes não precisa disso.
MIGRACOES_TOKEN=

# E-mails do sistema (esqueci minha senha). Sem MAIL_SMTP_HOST usa o mail() do PHP da hospedagem.
# MAIL_DE deve ser um e-mail do seu domínio (crie a caixa na hospedagem) para não cair no spam.
# SMTP: segurança = ssl (porta 465), tls (porta 587) ou nenhuma.
MAIL_DE=suporte@devacancy.online
MAIL_SMTP_HOST=
MAIL_SMTP_PORTA=465
MAIL_SMTP_SEGURANCA=ssl
MAIL_SMTP_USUARIO=
MAIL_SMTP_SENHA=
# Se o log mostrar erro de certificado SSL (comum em cPanel), coloque nao:
MAIL_SMTP_VERIFICAR=sim

# Importação de vagas da Adzuna (grátis: cadastre-se em https://developer.adzuna.com/signup).
# Sem essas chaves, esse importador é pulado (o do GitHub continua rodando normalmente).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# PayPal SÓ COM E-MAIL (sem API, sem conta Business): pagamento avulso. O PayPal avisa o site sozinho (IPN) quando o
# pagamento é concluído; se o aviso não chegar, o admin confirma em /admin/pagamentos. Use o e-mail da sua conta PayPal.
# PAYPAL_MODO precisa ser "live" para receber de verdade (sandbox só para testes).
PAYPAL_EMAIL=
