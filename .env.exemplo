# O .env guarda SÓ a conexão com o banco de dados: é o único dado que não pode ficar no próprio banco.
# Todo o resto (endereço do site, ambiente, pagamentos, planos, e-mail, login social, PIX, vagas...) se configura em
# Admin > Configuracoes e fica salvo no banco.

DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=devacancy
DB_USUARIO=root
DB_SENHA=

# Opcional e temporario: so se precisar rodar as migracoes (/install) sem acesso ao painel.
# 16+ caracteres aleatorios; APAGUE a linha depois de usar.
# MIGRACOES_TOKEN=
