APP_NOME=Devacancy
APP_URL=http://devacancy.test
APP_AMBIENTE=local

DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=devacancy
DB_USUARIO=root
DB_SENHA=

# Login social — preencha depois de criar os apps OAuth.
# URLs de retorno: {APP_URL}/auth/google/retorno, /auth/github/retorno, /auth/linkedin/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pagamentos — ExPay (https://expaybrasil.com/docs). Sem chave, em ambiente local, o checkout roda em modo simulação.
# Webhook: configure no painel ExPay a URL {APP_URL}/webhooks/expay?token={EXPAY_WEBHOOK_TOKEN}
EXPAY_URL=https://api.expay.com.br/v1
EXPAY_API_KEY=
EXPAY_WEBHOOK_TOKEN=
