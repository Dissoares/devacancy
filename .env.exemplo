# O .env guarda só o que o site precisa para ABRIR: o banco de dados e o endereço.
# Todo o resto (pagamentos, e-mail, login social, PIX, Asaas, Stripe, PayPal, vagas...) se configura em
# Admin > Configuracoes, sem abrir a hospedagem. O que for salvo la vale no lugar do .env.

# Endereco publico do site, sem barra no final. Fica aqui (e nao so no painel) porque os links dos e-mails e os
# redirecionamentos dependem dele desde a primeira visita. Em producao: https://seudominio
APP_URL=http://devacancy.test

# local = so na sua maquina (liga simulacoes de pagamento e mostra erros). NO SERVIDOR USE: producao
APP_AMBIENTE=local

# Banco de dados
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=devacancy
DB_USUARIO=root
DB_SENHA=

# Opcional: abre /install para rodar as migracoes (e criar o administrador) sem acesso ao painel.
# Use 16+ caracteres aleatorios e APAGUE depois de usar: sem esta linha a rota deixa de existir.
MIGRACOES_TOKEN=
