# Só a pasta public/ é acessível pela web. Todo o resto (src, views, .env, storage) fica protegido.
Options -Indexes
RewriteEngine On

RewriteRule ^(\.env|\.git|composer\.(json|lock)|vendor|src|views|config|routes|database|storage)(/|$) - [F,L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

# O bloco do cPanel abaixo só vale no servidor (onde o PHP não é módulo do Apache). No Laragon ele faria o Apache mostrar o código-fonte.
<IfModule !php_module>
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
</IfModule>
